## ── Build outputs ────────────────────────────────────────────────────────────
[Bb]in/
[Oo]bj/
[Ll]og/
logs/
publish/
*.user
*.suo
.vs/
.vscode/
.claude/

## ── .NET / NuGet ─────────────────────────────────────────────────────────────
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/
packages/

## ── ASP.NET Core secrets / environment overrides ─────────────────────────────
# appsettings.Development.json contains real localhost dev credentials.
# Each developer keeps their own local copy; it is NOT committed.
# Seed your copy from appsettings.Development.json.example (tracked in git).
appsettings.Development.json
appsettings.Local.json
appsettings.Production.json
appsettings.Staging.json

# .NET User Secrets (stored outside the repo, per machine)
secrets.json

## ── Docker / observability artefacts ─────────────────────────────────────────
# Local volume data (generated by docker compose)
deploy/observability/data/
# Defensive: en caso de que alguien cambie el named volume del SQL Server por bind mount
deploy/database/data/

## ── Test results & coverage (dotnet test --logger trx + coverlet) ───────────
TestResults/
test-results/
*.trx
*.coverage
*.coveragexml
coverage.cobertura.xml

## ── NuGet restore artefacts (never commit, fully reproducible via restore) ───
**/project.assets.json
**/project.nuget.cache
**/*.nuget.dgspec.json

## ── Environment / secrets files ──────────────────────────────────────────────
.env
.env.*
!.env.example

## ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

## ── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
*.DotSettings.user
.vscode/settings.json

## ── Visual Studio per-user solution data ─────────────────────────────────────
*.rsuser

## ── VS Code "Local History" extension ────────────────────────────────────────
.history/

## ── Editor swap / backup files ───────────────────────────────────────────────
*.swp
*.swo
*~
*.bak
*.tmp

## ── Coverage HTML reports (reportgenerator, etc.) ────────────────────────────
coverage/
coveragereport/
