#!/bin/sh
# commit-msg: Conventional Commits subject (<= 72 chars) and no AI attribution.
# Enabled with: git config core.hooksPath .githooks   (docs/adr/0027-hooks-de-git-con-core-hookspath.md)

msg_file="$1"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  echo "commit-msg: message file not found" >&2
  exit 1
fi

# Ignore comment lines and carriage returns (Windows editors).
message=$(grep -v '^#' "$msg_file" | tr -d '\r')
subject=$(printf '%s\n' "$message" | sed -n '/[^[:space:]]/{p;q;}')

fail() {
  echo "commit-msg: $1" >&2
  echo "  Subject: $subject" >&2
  echo "  Rules: CLAUDE.md section 6 and .claude/skills/commit/SKILL.md" >&2
  exit 1
}

[ -n "$subject" ] || fail "empty commit message."

# Messages generated by git itself are accepted as they are.
case "$subject" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*) generated=1 ;;
  *) generated=0 ;;
esac

if [ "$generated" -eq 0 ]; then
  types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
  if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9._/-]+\))?!?: [^ ].*"; then
    fail "subject must follow Conventional Commits: type(scope): subject (types: ${types})."
  fi
  if [ "${#subject}" -gt 72 ]; then
    fail "subject is ${#subject} characters long; the limit is 72."
  fi
fi

# No AI attribution or mention of a model or assistant anywhere in the message.
if printf '%s\n' "$message" | grep -Eiq 'co-authored-by:|generated with|noreply@anthropic|anthropic|claude (code|opus|sonnet|haiku|fable)|chatgpt|openai|copilot'; then
  fail "the message contains AI attribution or a reference to a model or assistant."
fi

exit 0
