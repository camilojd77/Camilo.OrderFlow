      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{exported_job=\"Camilo.OrderFlow.WebApi\"}[$__rate_interval]))"
