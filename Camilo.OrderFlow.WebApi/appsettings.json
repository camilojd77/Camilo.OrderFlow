{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Db": ""
  },
  "Jwt": {
    "Issuer": "Camilo.OrderFlow",
    "Audience": "Camilo.OrderFlow.WebApi",
    "Key": "",
    "ExpiresMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "OpenTelemetry": {
    "Enabled": false,
    "ServiceName": "Camilo.OrderFlow.WebApi",
    "ServiceVersion": "1.0.0",
    "Environment": "production",
    "OtlpEndpoint": "",
    "ExporterProtocol": "grpc",
    "SampleRatio": 1.0,
    "EnableSqlClientInstrumentation": false,
    "DbTracingCaptureStatements": false,
    "EnableConsoleExporter": false
  },
  "Resilience": {
    "ErpClient": {
      "TimeoutSeconds": 30,
      "RetryCount": 3,
      "BaseDelayMs": 200,
      "CircuitBreaker": {
        "FailureThreshold": 0.5,
        "SamplingDurationSeconds": 30,
        "MinimumThroughput": 20,
        "BreakDurationSeconds": 20
      }
    }
  },
  "RateLimiting": {
    "Default": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Seed": {
    "Enabled": false
  },

  "Permissions": {
    "CacheTtlMinutes": 10,
    "LocalCacheTtlMinutes": 5
  },

  "Cache": {
    "Redis": null
  },

  "Lockout": {
    "MaxAttempts": 5,
    "DurationMinutes": 15
  },

  "RefreshToken": {
    "ExpiresHours": 720
  },

  "Cors": {
    "Enabled": true,
    "AllowedOrigins": [ "http://localhost:3000" ],
    "AllowCredentials": false
  },

  "AllowedHosts": "*",

  "SecurityHeaders": {
    "Enabled": true,
    "HstsEnabled": true,
    "XFrameOptions": "DENY",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "CspEnabled": false,
    "ContentSecurityPolicy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'"
  },

  "Kestrel": {
    "Limits": {
      "MaxRequestBodySizeBytes": 10485760,
      "RequestHeadersTimeoutSeconds": 30,
      "KeepAliveTimeoutSeconds": 120
    }
  }
}
