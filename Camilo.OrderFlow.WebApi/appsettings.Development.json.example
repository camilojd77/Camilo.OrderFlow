{
  "Seed": {
    "Enabled": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=CamiloOrderFlowDev;User Id=sa;Password=Password123!;TrustServerCertificate=True;Encrypt=False;",
    "Db": "Server=localhost,1433;Database=CamiloOrderFlowDev;User Id=sa;Password=Password123!;TrustServerCertificate=True;Encrypt=False;"
  },
  "Jwt": {
    "Issuer": "Camilo.OrderFlow",
    "Audience": "Camilo.OrderFlow.WebApi",
    "Key": "DEV_ONLY_SUPER_SECRET_KEY_CHANGE_ME_32+CHARS_LONG",
    "ExpiresMinutes": 60
  },
  "RefreshToken": {
    "ExpiresHours": 720
  },
  "Lockout": {
    "MaxAttempts": 5,
    "DurationMinutes": 15
  },
  "Permissions": {
    "CacheTtlMinutes": 10,
    "LocalCacheTtlMinutes": 1
  },
  "Cache": {
    "Redis": null
  },
  "RateLimiting": {
    "Default": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Using": [ "Serilog.Sinks.Grafana.Loki" ],
    "WriteTo": [
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            { "key": "app", "value": "camilo-order-flow-webapi" },
            { "key": "env", "value": "dev" }
          ],
          "propertiesAsLabels": [ "Level" ]
        }
      }
    ]
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "Camilo.OrderFlow.WebApi",
    "Environment": "dev",
    "OtlpEndpoint": "http://localhost:4317",
    "ExporterProtocol": "grpc",
    "SampleRatio": 1.0,
    "EnableSqlClientInstrumentation": true,
    "DbTracingCaptureStatements": true,
    "EnableConsoleExporter": false
  },
  "SecurityHeaders": {
    "Enabled": true,
    "HstsEnabled": false,
    "XFrameOptions": "DENY",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "CspEnabled": false
  },
  "Cors": {
    "Enabled": true,
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:5173"
    ],
    "AllowCredentials": false
  }
}
