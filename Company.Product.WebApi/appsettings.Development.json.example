{
  "Seed": {
    "Enabled": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=ProjectDev;User Id=sa;Password=Password123!;TrustServerCertificate=True;Encrypt=False;",
    "Db": "Server=localhost,1433;Database=ProjectDev;User Id=sa;Password=Password123!;TrustServerCertificate=True;Encrypt=False;"
  },
  "Jwt": {
    "Key": "DEV_ONLY_SUPER_SECRET_KEY_CHANGE_ME_32+CHARS_LONG"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Using": [ "Serilog.Sinks.Grafana.Loki" ],
    "WriteTo": [
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            { "key": "app", "value": "company-product-webapi" },
            { "key": "env", "value": "dev" }
          ],
          "propertiesAsLabels": [ "Level" ]
        }
      }
    ]
  },
  "OpenTelemetry": {
    "Enabled": true,
    "Environment": "dev",
    "OtlpEndpoint": "http://localhost:4317",
    "EnableSqlClientInstrumentation": true,
    "DbTracingCaptureStatements": true
  },
  "SecurityHeaders": {
    "HstsEnabled": false
  },
  "Cors": {
    "Enabled": true,
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:5173"
    ],
    "AllowCredentials": false
  }
}
