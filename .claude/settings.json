{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git merge-base *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(git branch --show-current)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "Bash(git commit *--no-verify*)",
      "PowerShell(git commit *--no-verify*)",
      "Bash(git commit * -n *)",
      "PowerShell(git commit * -n *)",
      "Bash(git remote set-url *)",
      "PowerShell(git remote set-url *)",
      "Bash(git remote rename *)",
      "PowerShell(git remote rename *)",
      "Bash(dotnet nuget push *)",
      "PowerShell(dotnet nuget push *)",
      "Bash(dotnet ef database drop *)",
      "PowerShell(dotnet ef database drop *)",
      "Bash(docker compose * down -v*)",
      "PowerShell(docker compose * down -v*)",
      "Bash(*dev/observability.ps1 wipe*)",
      "PowerShell(*dev\\observability.ps1 wipe*)",
      "PowerShell(*dev/observability.ps1 wipe*)"
    ]
  }
}
