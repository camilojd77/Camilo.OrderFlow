<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3: cada proyecto de test es un ejecutable autocontenido. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <!--
    Project references load the assemblies at test runtime so NetArchTest can
    reflect over them.  No production code from these projects is executed.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Camilo.OrderFlow.Modules.Identity.Domain\Camilo.OrderFlow.Modules.Identity.Domain.csproj" />
    <ProjectReference Include="..\..\Camilo.OrderFlow.Modules.Identity.Application\Camilo.OrderFlow.Modules.Identity.Application.csproj" />
    <ProjectReference Include="..\..\Camilo.OrderFlow.Modules.Identity.Infrastructure\Camilo.OrderFlow.Modules.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Camilo.OrderFlow.WebApi\Camilo.OrderFlow.WebApi.csproj" />
  </ItemGroup>

</Project>
